# Copy to terraform.tfvars and adjust. All values have defaults except
# subscription_id. Run `az account show --query id -o tsv` to get it.

subscription_id = "00000000-0000-0000-0000-000000000000"

# Region (must support Flex Consumption, Dedicated plans and Azure Load Testing).
# Note: westeurope may reject new resources ("not accepting new customers");
# swedencentral is a good alternative.
location = "swedencentral"

# Short prefix for resource names (a random 4-hex suffix is added automatically).
name_prefix = "fnvs"

# Public IPv4 of the machine running terraform / func publish.
# Leave commented to auto-discover via api.ipify.org.
# deployer_ipv4 = "203.0.113.25"

# --- Plan sizing (kept small and comparable for the demo) --------------------
flex_instance_memory_mb     = 2048
flex_maximum_instance_count = 40
flex_always_ready_count     = 0
# "Premium" side runs on a Dedicated App Service plan (keyless, always-on).
premium_sku_name     = "P0v3"
premium_worker_count = 1

# Optional third arm: EP1 WITHOUT Azure Files. Read docs/STARTUP-COMPARISON.md.
# Stage 1 creates private storage/identity/networking only (no EP compute yet).
# enable_elastic_premium = true
# ep_publisher_principal_id = "<private-executor-object-id>"
# Stage 2: upload from the private executor, then set the printed SHA256.
# ep_package_sha256 = "<64-character-lowercase-sha256>"
# ep_minimum_instances = 1
# ep_prewarmed_instances = 1
# ep_maximum_instances = 3

# Optional private managed-identity VM for publication and verification.
# No public VM IP or SSH ingress; outbound-only NAT has a separate charge.
# enable_verification_runner = true
# verification_ssh_public_key_path = "C:\\keys\\verification.pub"
# flex_runtime_version = "22"
# premium_node_version = "22"
